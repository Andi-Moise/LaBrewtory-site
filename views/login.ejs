   <div class="login-container">
    <form class="login-card"  action="/login" method="POST">
      <h2 class="en">Login to your account</h2>
      <!-- <h2 class="ro">Autentificare în contul tău</h2>
      <h2 class="ru">Войдите в свой аккаунт</h2> -->
      <h2 class="error-message">
        <% if (messages.error) { %>
  <%= messages.error %>
<% } %>
      </h2>
      
      <label for="email" class="en">Email</label>
      <!-- <label for="email" class="ro">Email</label>
      <label for="email" class="ru">Электронная почта</label> -->
      <input type="email" id="email" name="email" required placeholder="Enter your email">

      <div class="password-label">
        <label for="password" class="en">Password</label>
        <!-- <label for="password" class="ro">Parolă</label>
        <label for="password" class="ru">Пароль</label> -->
        
      </div>
      <div class="password-input">
        <input type="password" id="password" name="password" required placeholder="Enter your password">
        
        
      </div>

      <button type="submit" class="en">Login now</button>
      <!-- <button type="submit" class="ro">Autentificare</button>
